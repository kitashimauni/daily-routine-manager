COMPOSE_PROJECT_NAME=daily-routine-manager-preview
FRONTEND_NETWORK_NAME=routine-preview-frontend
BACKEND_NETWORK_NAME=routine-preview-backend
DATABASE_URL=postgresql://routine_preview:change_me@postgres:5432/routine_preview
POSTGRES_DB=routine_preview
POSTGRES_USER=routine_preview
POSTGRES_PASSWORD=change_me
APP_TIME_ZONE=Asia/Tokyo
DEPLOY_ENV=preview
RELEASE_VERSION=0.1.0-preview
RELEASE_COMMIT_SHA=replace_with_preview_commit_sha
RELEASE_BRANCH=replace_with_preview_branch
TRUST_PROXY_HEADERS=true
BACKUP_DIR=/srv/daily-routine-manager-preview/backups
BACKUP_RETENTION_DAYS=7
