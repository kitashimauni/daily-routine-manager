COMPOSE_PROJECT_NAME=daily-routine-manager-production
FRONTEND_NETWORK_NAME=routine-frontend
BACKEND_NETWORK_NAME=routine-backend
DATABASE_URL=postgresql://routine:change_me@postgres:5432/routine_manager
POSTGRES_DB=routine_manager
POSTGRES_USER=routine
POSTGRES_PASSWORD=change_me
APP_TIME_ZONE=Asia/Tokyo
DEPLOY_ENV=production
RELEASE_VERSION=0.1.0
RELEASE_COMMIT_SHA=replace_with_main_commit_sha
RELEASE_BRANCH=main
TRUST_PROXY_HEADERS=true
BACKUP_DIR=/srv/daily-routine-manager-backups
BACKUP_RETENTION_DAYS=7
